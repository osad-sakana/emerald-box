---
interface Props {
  title?: string
}
const { title = 'Emerald Box — Web Sandbox' } = Astro.props
---

<!doctype html>
<html lang="ja" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ブラウザ内で完結するHTML/CSS/JSプレビューツール" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}
    />
    <meta name="theme-color" content="#059669" />
    <title>{title}</title>
    <!-- AIワークショップモード: Monaco 読み込み待ちの間にパーツ集が見えないよう、描画前にクエリを見て印を付ける。 -->
    <script is:inline>
      try {
        if (new URLSearchParams(location.search).get('ai-workshop') === 'true') {
          document.documentElement.setAttribute('data-ai-workshop', 'true')
        }
      } catch {}
    </script>
  </head>
  <body class="h-full overflow-hidden bg-slate-950 font-sans text-slate-100 antialiased">
    <slot />
  </body>
</html>

<style is:global>
  /* 0xProto を CDN (jsDelivr) から読み込む */
  @font-face {
    font-family: '0xProto';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('https://cdn.jsdelivr.net/gh/0xType/0xProto@2.502/fonts/0xProto-Regular.woff2')
      format('woff2');
  }
  @font-face {
    font-family: '0xProto';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('https://cdn.jsdelivr.net/gh/0xType/0xProto@2.502/fonts/0xProto-Bold.woff2')
      format('woff2');
  }
  @font-face {
    font-family: '0xProto';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url('https://cdn.jsdelivr.net/gh/0xType/0xProto@2.502/fonts/0xProto-Italic.woff2')
      format('woff2');
  }

  html,
  body {
    margin: 0;
    height: 100%;
  }

  /* AIワークショップモード: パーツ集・ラッピングを隠し、貼り付けボタンを出す */
  .eb-ai-only {
    display: none;
  }
  html[data-ai-workshop='true'] .eb-hide-in-ai {
    display: none !important;
  }
  html[data-ai-workshop='true'] .eb-ai-only {
    display: inline-flex;
  }

  /* 講師モード: 基準からの変更行ハイライト */
  .eb-diff-line {
    background-color: rgba(16, 185, 129, 0.12);
  }
  .eb-diff-gutter {
    border-left: 3px solid rgba(16, 185, 129, 0.8);
  }
  .eb-diff-deleted-gutter {
    border-left: 3px solid rgba(239, 68, 68, 0.8);
  }
  .eb-diff-inline {
    background-color: rgba(16, 185, 129, 0.28);
    border-bottom: 2px solid rgba(16, 185, 129, 0.9);
  }
  /* beforeContentClassName でゼロ幅位置に描画される、行内削除位置を示す縦線マーカー。 */
  .eb-diff-inline-deleted::before {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-bottom: -0.15em;
    background-color: rgba(239, 68, 68, 0.9);
  }
</style>
