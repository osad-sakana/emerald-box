---
// アプリ最上部のヘッダー。左にアプリ名、右に操作ボタン群。
// base 付き環境でも壊れないようアイコンのパスを正規化する。
const iconUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`
---

<header
  class="flex items-center justify-between border-b border-emerald-800 bg-slate-900 px-4 py-2.5"
>
  <div class="flex items-center gap-2">
    <img
      src={iconUrl}
      alt="Emerald Box"
      width="28"
      height="28"
      class="h-7 w-7 drop-shadow-[0_0_6px_rgba(16,185,129,0.45)]"
    />
    <h1 class="flex items-baseline gap-2">
      <span
        class="bg-gradient-to-r from-emerald-300 via-emerald-400 to-emerald-600 bg-clip-text text-lg font-extrabold tracking-tight text-transparent"
      >
        Emerald Box
      </span>
      <span
        class="rounded-full border border-emerald-700/60 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-emerald-300"
      >
        Web Sandbox
      </span>
    </h1>
  </div>

  <div class="flex items-center gap-2">
    <span
      id="save-status"
      class="mr-1 hidden text-xs text-emerald-400"
      aria-live="polite"></span>

    <span
      id="js-status"
      class="mr-1 hidden text-xs text-emerald-400"
      aria-live="polite"><span aria-hidden="true">●</span> 実行中</span>

    <button
      id="btn-run"
      type="button"
      class="rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-emerald-500 active:scale-95"
    >
      ▶ JS実行
    </button>

    <button
      id="btn-stop"
      type="button"
      class="rounded-md bg-slate-700 px-3 py-1.5 text-sm font-semibold text-slate-100 transition hover:bg-red-600 active:scale-95"
    >
      ■ 強制終了
    </button>

    <button
      id="btn-reset"
      type="button"
      class="rounded-md bg-slate-700 px-3 py-1.5 text-sm font-semibold text-slate-100 transition hover:bg-amber-600 active:scale-95"
    >
      環境初期化
    </button>

    <span class="mx-1 h-5 w-px bg-slate-700" aria-hidden="true"></span>

    <!-- 講師モード・ライセンスをまとめたハンバーガーメニュー -->
    <div class="relative">
      <button
        id="btn-menu"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="メニュー"
        class="rounded-md border border-slate-700 px-2.5 py-1.5 text-sm font-medium text-slate-400 transition hover:border-emerald-700 hover:text-emerald-400"
      >
        ☰
      </button>
      <div
        id="menu-dropdown"
        class="hidden absolute right-0 top-full z-20 mt-2 w-52 flex-col gap-1 rounded-md border border-slate-700 bg-slate-900 p-1.5 shadow-lg"
      >
        <button
          id="btn-instructor"
          type="button"
          aria-pressed="false"
          class="w-full rounded-md px-3 py-1.5 text-left text-sm font-medium text-slate-400 transition hover:bg-slate-800 hover:text-emerald-400"
        >
          講師モード
        </button>
        <button
          id="btn-credits"
          type="button"
          class="w-full rounded-md px-3 py-1.5 text-left text-sm font-medium text-slate-400 transition hover:bg-slate-800 hover:text-emerald-400"
          aria-label="ライセンス表示"
        >
          ⓘ ライセンス
        </button>

        <div class="my-1 h-px bg-slate-700" aria-hidden="true"></div>

        <label
          class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm font-medium text-slate-400 transition hover:bg-slate-800 hover:text-emerald-400"
          title="Tailwind CSS有効時はPreflightが優先されるため、効果が分かりやすいのはTailwind CSS無効時です"
        >
          <input
            id="chk-reset-css"
            type="checkbox"
            class="h-3.5 w-3.5 accent-emerald-500"
          />
          Reset CSSを有効化
        </label>
        <label
          class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm font-medium text-slate-400 transition hover:bg-slate-800 hover:text-emerald-400"
        >
          <input
            id="chk-tailwind"
            type="checkbox"
            checked
            class="h-3.5 w-3.5 accent-emerald-500"
          />
          Tailwind CSSを有効化
        </label>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('btn-menu')!
  const menuDropdown = document.getElementById('menu-dropdown')!

  const setMenuOpen = (open: boolean) => {
    menuBtn.setAttribute('aria-expanded', String(open))
    menuDropdown.classList.toggle('hidden', !open)
    menuDropdown.classList.toggle('flex', open)
  }

  menuBtn.addEventListener('click', (e) => {
    e.stopPropagation()
    setMenuOpen(menuDropdown.classList.contains('hidden'))
  })
  document.addEventListener('click', (e) => {
    if (!menuDropdown.contains(e.target as Node) && e.target !== menuBtn) setMenuOpen(false)
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false)
  })
  // メニュー内の項目をクリックしたら閉じる（講師モード切替・ライセンス表示どちらも実行後に閉じてよい）。
  // ただしチェックボックス（reset CSS / Tailwind CSS）は複数連続で切り替えたいため閉じない。
  menuDropdown.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('label')) return
    setMenuOpen(false)
  })
</script>
