---
// JavaScript公式ロゴ(Roger Ferguson作, パブリックドメイン相当)をオマージュしたオリジナルSVG。
// クレジットは src/lib/licenses.ts / Credits.astro に記載。
interface Props {
  class?: string
}
const { class: className = 'h-4 w-4' } = Astro.props
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true" focusable="false">
  <rect x="2" y="2" width="28" height="28" fill="#F7DF1E" />
  <text
    x="16"
    y="23"
    font-size="12"
    font-weight="700"
    fill="#000"
    text-anchor="middle"
    font-family="sans-serif">JS</text
  >
</svg>
