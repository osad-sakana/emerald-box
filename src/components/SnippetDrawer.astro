---
// パーツ集ドロワー。#panes（relative）の中に重ねて表示し、レイアウトには影響しない。
// 挿入・コピーの実処理は index.astro 側（data-snippet-action の委譲）で行い、ここは開閉とタブ切替のみ。
import Html5Icon from './icons/Html5Icon.astro'
import Css3Icon from './icons/Css3Icon.astro'
import JsIcon from './icons/JsIcon.astro'
import { SNIPPET_LANG_LABELS, snippetsByLang } from '../lib/snippets'
import type { EditorLang } from '../lib/storage'

const LANGS: EditorLang[] = ['html', 'css', 'javascript']
const groups = LANGS.map((lang) => {
  const items = snippetsByLang(lang)
  const categories = [...new Set(items.map((s) => s.category))]
  return {
    lang,
    label: SNIPPET_LANG_LABELS[lang],
    categories: categories.map((category) => ({
      category,
      items: items.filter((s) => s.category === category),
    })),
  }
})
---

<aside
  id="snippet-drawer"
  aria-label="パーツ集"
  class="hidden absolute bottom-0 left-0 top-0 z-30 w-80 max-w-[60%] flex-col border-r border-emerald-800 bg-slate-900 shadow-2xl"
>
  <div class="flex items-start justify-between gap-2 border-b border-slate-800 px-3 py-2">
    <div>
      <h2 class="text-sm font-bold text-emerald-400">パーツ集</h2>
      <p class="text-[11px] text-slate-500">ボタンでエディタに入れたり、コピーしたりできます</p>
    </div>
    <button
      id="btn-snippets-close"
      type="button"
      aria-label="閉じる"
      class="rounded-md px-2 py-1 text-sm text-slate-400 transition hover:text-slate-100"
    >
      ✕
    </button>
  </div>

  <div role="tablist" class="flex gap-1 border-b border-slate-800 px-2 py-1.5">
    {
      groups.map((g) => (
        <button
          type="button"
          role="tab"
          class="snippet-tab flex items-center gap-1.5 rounded-md px-3 py-1 text-sm font-medium text-slate-400 transition"
          data-snippet-tab={g.lang}
          aria-selected={g.lang === 'html' ? 'true' : 'false'}
        >
          {g.lang === 'html' && <Html5Icon class="h-3.5 w-3.5 shrink-0" />}
          {g.lang === 'css' && <Css3Icon class="h-3.5 w-3.5 shrink-0" />}
          {g.lang === 'javascript' && <JsIcon class="h-3.5 w-3.5 shrink-0" />}
          {g.label}
        </button>
      ))
    }
  </div>

  <p
    id="snippet-status"
    aria-live="polite"
    class="min-h-[1.5rem] border-b border-slate-800 px-3 py-1 text-xs text-emerald-400"
  >
  </p>

  <div class="min-h-0 flex-1 overflow-y-auto">
    {
      groups.map((g) => (
        <div
          role="tabpanel"
          class:list={['snippet-panel p-3', g.lang !== 'html' && 'hidden']}
          data-snippet-panel={g.lang}
        >
          {g.categories.map((c) => (
            <section class="mb-4">
              <h3 class="mb-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                {c.category}
              </h3>
              <ul class="flex flex-col gap-2">
                {c.items.map((s) => (
                  <li class="rounded-md border border-slate-800 bg-slate-950 p-2">
                    <div class="mb-1 flex items-center gap-1.5 text-sm font-semibold text-slate-100">
                      <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-bold text-emerald-300">
                        {g.label}
                      </span>
                      {s.label}
                    </div>
                    <p class="mb-1.5 text-xs text-slate-400">{s.description}</p>
                    <pre
                      class="snippet-code mb-2 max-h-40 overflow-auto rounded bg-slate-900 p-2 text-xs text-slate-200"
                    ><code>{s.code}</code></pre>
                    <div class="flex gap-2">
                      <button
                        type="button"
                        data-snippet-action="insert"
                        data-snippet-id={s.id}
                        class="rounded-md bg-emerald-600 px-2.5 py-1 text-xs font-semibold text-white transition hover:bg-emerald-500 active:scale-95"
                      >
                        {g.label}に挿入
                      </button>
                      <button
                        type="button"
                        data-snippet-action="copy"
                        data-snippet-id={s.id}
                        class="rounded-md bg-slate-700 px-2.5 py-1 text-xs font-semibold text-slate-100 transition hover:bg-slate-600 active:scale-95"
                      >
                        コピー
                      </button>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ))
    }
  </div>
</aside>

<script>
  const drawer = document.getElementById('snippet-drawer')!
  const toggleBtn = document.getElementById('btn-snippets')!
  const closeBtn = document.getElementById('btn-snippets-close')!
  const statusEl = document.getElementById('snippet-status')!
  const tabs = Array.from(drawer.querySelectorAll<HTMLButtonElement>('.snippet-tab'))
  const panels = Array.from(drawer.querySelectorAll<HTMLElement>('.snippet-panel'))

  // hidden / flex は排他的に切り替える（クラス定義順に頼らない）。
  const setOpen = (open: boolean) => {
    drawer.classList.toggle('hidden', !open)
    drawer.classList.toggle('flex', open)
    toggleBtn.setAttribute('aria-expanded', String(open))
    toggleBtn.classList.toggle('bg-emerald-600', open)
    toggleBtn.classList.toggle('text-white', open)
    toggleBtn.classList.toggle('text-slate-400', !open)
    if (!open) statusEl.textContent = ''
    // エディタ側の Esc コマンドの有効条件（コンテキストキー）に反映させる。
    document.dispatchEvent(new CustomEvent('snippet-drawer:state', { detail: open }))
  }

  const selectTab = (lang: string) => {
    for (const tab of tabs) {
      const active = tab.dataset.snippetTab === lang
      tab.setAttribute('aria-selected', String(active))
      tab.classList.toggle('bg-emerald-600', active)
      tab.classList.toggle('text-white', active)
      tab.classList.toggle('text-slate-400', !active)
    }
    for (const panel of panels) {
      panel.classList.toggle('hidden', panel.dataset.snippetPanel !== lang)
    }
  }

  toggleBtn.addEventListener('click', () => setOpen(drawer.classList.contains('hidden')))
  closeBtn.addEventListener('click', () => setOpen(false))
  for (const tab of tabs) {
    tab.addEventListener('click', () => selectTab(tab.dataset.snippetTab!))
  }
  selectTab('html')

  // エディタ内の Esc は Monaco コマンド（lib/snippet-drawer-keybinding.ts）がこのイベントで通知する。
  document.addEventListener('snippet-drawer:close', () => setOpen(false))

  // 以下の document の keydown はエディタ外の Esc 用。エディタ内の Esc は上記コマンドに任せ、二重処理を避ける。
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || drawer.classList.contains('hidden')) return
    if ((e.target as HTMLElement | null)?.closest?.('.monaco-editor')) return
    setOpen(false)
  })
</script>
